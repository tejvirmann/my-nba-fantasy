# Copy to .env.local and fill in. Lines marked VERCEL also go in Vercel -> Settings -> Environment Variables.

# VERCEL: pooled connection (Supabase -> Project Settings -> Database -> Connection pooling, port 6543)
POSTGRES_URL=
# local only: direct connection used by `npm run db:migrate` (port 5432)
POSTGRES_URL_NON_POOLING=

# VERCEL: Supabase -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# local only: used by seed and test scripts. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# VERCEL: any long random string, e.g. `openssl rand -hex 24`
CRON_SECRET=
# VERCEL: comma-separated emails that are always admins
ADMIN_EMAILS=
